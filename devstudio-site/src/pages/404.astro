---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <section class="hero wrap" style="padding-bottom:clamp(80px, 12vw, 160px)">
    <p class="label">(404)</p>
    <h1 class="display">
      <span class="hero-line"><span>PAGE</span></span>
      <span class="hero-line" style="--i:1"><span class="accent">NOT FOUND</span></span>
    </h1>
    <p class="lead" style="margin-top:32px" data-reveal>요청하신 페이지가 없거나 주소가 바뀌었습니다.</p>
    <div style="margin-top:32px" data-reveal><a href="/" class="btn btn-solid">메인으로 →</a></div>
  </section>
</Base>
